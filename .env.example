# Ethereum RPC URL (Required)
RPC_URL=https://1rpc.io/eth

# Private Key for signing (Optional, default: None)
PRIVATE_KEY=

# Server Port (Optional, default: 3000)
PORT=3000

# Logging Level (Optional, default: info)
RUST_LOG=info

# Default Slippage for Swaps (Optional, default: 0.005)
DEFAULT_SLIPPAGE=0.005

# Uniswap V3 Fee Tier (Optional, default: 3000)
UNISWAP_FEE_TIER=3000

# Cache TTL in seconds (Optional, default: 5)
CACHE_TTL=5

# SMTP Configuration for Notifications (Optional)
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=alerts@example.com
SMTP_TO=admin@example.com

# Contract Addresses (Optional, defaults to Ethereum Mainnet)
# USDC Token Address
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Uniswap V3 Quoter V2 Address
UNISWAP_QUOTER_ADDRESS=0x61fFE014bA17989E743c5F6cB21bF9697530B21e

# Uniswap V3 Swap Router 02 Address
UNISWAP_ROUTER_ADDRESS=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
